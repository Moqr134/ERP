@namespace ERP_Clint.Pages.Reports
@using ERPDto.ReportsDto

@if (Items is null || Items.Count == 0)
{
    <div class="report-empty">لا توجد بيانات للاتجاه</div>
}
else
{
    <div class="trend-chart">
        @{
            var max = Items.Max(i => i.Total);
            if (max <= 0) max = 1;
        }
        <div class="trend-chart__bars">
            @foreach (var item in Items)
            {
                var pct = Math.Clamp((item.Total / max) * 100, 4, 100);
                <div class="trend-chart__col" title="@($"{item.Date:MM/dd}: {item.Total:N0} ({item.Count})")">
                    <div class="trend-chart__bar" style="height:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    <span>@item.Date.ToString("dd")</span>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public List<DailyMetricDto>? Items { get; set; }
}
