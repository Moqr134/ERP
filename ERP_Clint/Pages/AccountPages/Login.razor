@page "/login"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations

<div class="login-card">

    <div class="login-card__brand">
        <div class="brand-logo">ERP</div>
        <h1>نظام إدارة الموارد</h1>
        <p>سجّل الدخول لمتابعة العمل على لوحة التحكم</p>
    </div>

    <EditForm Model="@model" OnValidSubmit="HandleLogin" class="login-form">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error">
                <span>⚠</span> @errorMessage
            </div>
        }

        <div class="form-group">
            <label>اسم المستخدم</label>
            <div class="input-wrap">
                <span class="input-icon">👤</span>
                <InputText @bind-Value="model.Username" class="form-input" placeholder="ادخل اسم المستخدم" />
            </div>
            <ValidationMessage For="@(() => model.Username)" />
        </div>

        <div class="form-group">
            <label>كلمة المرور</label>
            <div class="input-wrap">
                <span class="input-icon">🔒</span>
                <InputText @bind-Value="model.Password" type="@(showPassword ? "text" : "password")" class="form-input" placeholder="ادخل كلمة المرور" />
                <button type="button" class="toggle-pass" @onclick="TogglePassword">
                    @(showPassword ? "🙈" : "👁")
                </button>
            </div>
            <ValidationMessage For="@(() => model.Password)" />
        </div>

        <div class="form-row">
            <a href="/forgot-password" class="forgot-link">نسيت كلمة المرور؟</a>
        </div>

        <button type="submit" class="btn-submit" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner"></span>
                <span>جاري تسجيل الدخول...</span>
            }
            else
            {
                <span>تسجيل الدخول</span>
            }
        </button>
    </EditForm>

    <div class="login-card__extra">
        <span>تحتاج مساعدة؟</span>
        <a href="mailto:support@company.com">تواصل مع الدعم الفني</a>
    </div>
</div>
<style>

    .login-card {
        width: 100%;
        max-width: 420px;
        background: rgba(20, 26, 34, 0.85);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 40px 36px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        color: #e8edf2;
        font-family: 'Cairo', sans-serif;
    }

    .login-card__brand {
        text-align: center;
        margin-bottom: 28px;
    }

    .brand-logo {
        width: 56px;
        height: 56px;
        margin: 0 auto 14px;
        border-radius: 14px;
        background: linear-gradient(135deg, #f97316, #c2410c);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
        color: #fff;
        box-shadow: 0 8px 20px rgba(249,115,22,0.25);
    }

    .login-card__brand h1 {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 6px;
        color: #fff;
    }

    .login-card__brand p {
        font-size: 13px;
        color: rgba(255,255,255,0.5);
        margin: 0;
    }

    .alert-error {
        background: rgba(220, 53, 69, 0.12);
        border: 1px solid rgba(220, 53, 69, 0.35);
        color: #ff8a94;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            margin-bottom: 8px;
            color: rgba(255,255,255,0.75);
            font-weight: 600;
        }

    .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        right: 14px;
        font-size: 15px;
        opacity: 0.55;
        pointer-events: none;
    }

    .form-input {
        width: 100%;
        padding: 12px 42px 12px 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        color: #fff;
        font-size: 14px;
        font-family: 'Cairo', sans-serif;
        outline: none;
        transition: border-color .2s, background .2s;
    }

        .form-input::placeholder {
            color: rgba(255,255,255,0.3);
        }

        .form-input:focus {
            border-color: #f97316;
            background: rgba(255,255,255,0.06);
        }

    .toggle-pass {
        position: absolute;
        left: 12px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        opacity: 0.6;
    }

    .validation-message {
        color: #ff8a94;
        font-size: 12px;
        margin-top: 6px;
        display: block;
    }

    .form-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        font-size: 13px;
    }

    .remember {
        display: flex;
        align-items: center;
        gap: 6px;
        color: rgba(255,255,255,0.7);
        cursor: pointer;
    }

    .forgot-link {
        color: #f97316;
        text-decoration: none;
    }

        .forgot-link:hover {
            text-decoration: underline;
        }

    .btn-submit {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #f97316, #c2410c);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: opacity .2s, transform .15s;
    }

        .btn-submit:hover:not(:disabled) {
            transform: translateY(-1px);
        }

        .btn-submit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .login-card__extra {
        margin-top: 22px;
        text-align: center;
        font-size: 13px;
        color: rgba(255,255,255,0.45);
    }

        .login-card__extra a {
            color: #f97316;
            text-decoration: none;
            margin-right: 4px;
        }

</style>
