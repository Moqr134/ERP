<div class="modal-overlay @(IsOpen ? "open" : "")">
    <div class="modal-box modal-box--sm">
        <div class="confirm-icon">🗑️</div>
        <p class="confirm-text">
            هل أنت متأكد من حذف <strong>@EntityLabel</strong> <strong>@TargetName</strong>؟<br>
            هذا الإجراء لا يمكن التراجع عنه.
        </p>
        <div class="modal-box__footer">
            <button class="btn-secondary" @onclick="Cancel" disabled="@IsDeleting">إلغاء</button>
            <button class="btn-danger" @onclick="Confirm" disabled="@IsDeleting">
                @(IsDeleting ? "جاري الحذف..." : "حذف نهائياً")
            </button>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.6);
        display: none; align-items: center; justify-content: center; z-index: 100;
        backdrop-filter: blur(3px);
    }
    .modal-overlay.open { display: flex; }

    .modal-box--sm { max-width: 360px; }

    .modal-box {
        width: 100%; background: #141a22;
        border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;
        padding: 26px; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        font-family: 'Cairo', sans-serif;
    }

    .confirm-icon {
        width: 54px; height: 54px; border-radius: 50%; background: rgba(239,68,68,0.12);
        display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 16px;
    }
    .confirm-text { text-align: center; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 22px; line-height: 1.7; }
    .confirm-text strong { color: #fff; }

    .modal-box__footer { display: flex; gap: 10px; }
    .modal-box__footer button { flex: 1; }

    .btn-secondary {
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #e8edf2;
        font-weight: 600; padding: 10px 18px; border-radius: 10px; font-size: 13px;
        font-family: 'Cairo', sans-serif; cursor: pointer;
    }
    .btn-danger {
        background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171;
        font-weight: 700; padding: 10px 18px; border-radius: 10px; font-size: 13px;
        font-family: 'Cairo', sans-serif; cursor: pointer;
    }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

@code {
    /// <summary>هل الـ Modal مفتوح حالياً</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>اسم العنصر المراد حذفه (يظهر بنص التأكيد)</summary>
    [Parameter] public string TargetName { get; set; } = string.Empty;

    /// <summary>تسمية الكيان: "القسم"، "المورد"، "المنتج"...الخ</summary>
    [Parameter] public string EntityLabel { get; set; } = "العنصر";

    /// <summary>يستدعى عند الضغط على "حذف نهائياً"</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>يستدعى عند الإلغاء أو إغلاق الـ Modal</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    public bool IsDeleting { get; set; }

    private async Task Confirm()
    {
        IsDeleting = true;
        await OnConfirm.InvokeAsync();
        IsDeleting = false;
    }

    private async Task Cancel()
    {
        if (IsDeleting) return;
        await OnCancel.InvokeAsync();
    }
}
