@page "/inventory/categories"
@layout MainLayout
@attribute [Authorize(Roles = "FullAccess,GetAllCategories")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ERP_Clint.Security
@if (!isLoading && loadError is null)
{
    <div class="kpi-grid">
        <div class="kpi-card kpi-card--total">
            <div class="kpi-card__icon">🗂️</div>
            <div class="kpi-card__value">@categories.Count</div>
            <div class="kpi-card__label">إجمالي الأقسام</div>
        </div>
        <div class="kpi-card kpi-card--products">
            <div class="kpi-card__icon">📦</div>
            <div class="kpi-card__value">@categories.Sum(c => c.ProductCount)</div>
            <div class="kpi-card__label">إجمالي المنتجات بكل الأقسام</div>
        </div>
    </div>
}
<div class="table-panel">
    <div class="table-panel__header">
        <h3>قائمة الأقسام</h3>
        <div style="display:flex; gap:10px; align-items:center;">
            <div class="search-box">
                <span>🔍</span>
                <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="ابحث عن قسم..." />
            </div>
            <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.CreateCategory)">
                <Authorized>
                    <button class="btn-primary" @onclick="OpenAddModal">+ إضافة قسم</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-box">جاري تحميل الأقسام...</div>
    }
    else if (loadError is not null)
    {
        <div class="state-box state-box--error">
            ⚠ @loadError
            <button class="btn-secondary" @onclick="LoadCategories">إعادة المحاولة</button>
        </div>
    }
    else if (FilteredCategories.Count == 0)
    {
        <div class="state-box">لا توجد أقسام مطابقة</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>القسم</th>
                    <th>عدد المنتجات</th>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.UpdateCategory, PermissionNames.DeleteCategory)">
                        <Authorized>
                            <th>إجراءات</th>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in FilteredCategories)
                {
                    <tr>
                        <td>
                            <div class="cat-cell">
                                <div class="cat-icon">📁</div>
                                <div>
                                    <div class="cat-name">@category.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <div class="cat-desc">@category.Description</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>@category.ProductCount</td>
                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.UpdateCategory, PermissionNames.DeleteCategory)" Context="actionsCtx">
                            <Authorized>
                                <td>
                                    <div class="row-actions">
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.UpdateCategory)" Context="editCtx">
                                            <Authorized>
                                                <button @onclick="() => OpenEditModal(category)" title="تعديل">✏️</button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.DeleteCategory)" Context="delCtx">
                                            <Authorized>
                                                <button class="danger" @onclick="() => OpenDeleteModal(category)" title="حذف">🗑️</button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<CategoryModal IsOpen="isModalOpen"
               EditingCategory="categoryBeingEdited"
               OnSaved="HandleSaved"
               OnClose="CloseModal" />

<DeleteConfirmModal IsOpen="isDeleteModalOpen"
                     EntityLabel="القسم"
                     TargetName="@(categoryBeingDeleted?.Name ?? "")"
                     OnConfirm="HandleDeleteConfirmed"
                     OnCancel="CloseDeleteModal" />

<style>
    .table-panel { background: #141a22; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; overflow: hidden; }
    .table-panel__header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; gap: 12px;
    }
    .table-panel__header h3 { font-size: 15px; font-weight: 700; color: #fff; }

    .search-box {
        display: flex; align-items: center; gap: 8px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px; padding: 8px 12px; font-size: 13px; min-width: 220px;
    }
    .search-box input { background: none; border: none; outline: none; color: #fff; font-family: 'Cairo', sans-serif; font-size: 13px; width: 100%; }
    .search-box input::placeholder { color: rgba(255,255,255,0.3); }

    .btn-primary {
        background: linear-gradient(135deg, #f97316, #c2410c); border: none; color: #fff; font-weight: 700;
        padding: 9px 18px; border-radius: 10px; font-size: 13px; font-family: 'Cairo', sans-serif;
        cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-secondary {
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #e8edf2;
        font-weight: 600; padding: 9px 18px; border-radius: 10px; font-size: 13px;
        font-family: 'Cairo', sans-serif; cursor: pointer;
    }

    table { width: 100%; border-collapse: collapse; }
    thead th {
        background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.5); font-size: 11px;
        text-transform: uppercase; letter-spacing: 0.4px; padding: 12px 20px; text-align: right;
        font-weight: 700; border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    tbody td { padding: 14px 20px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.05); color: #e8edf2; }
    tbody tr:hover { background: rgba(249, 115, 22, 0.04); }
    tbody tr:last-child td { border-bottom: none; }

    .cat-cell { display: flex; align-items: center; gap: 10px; }
    .cat-icon {
        width: 34px; height: 34px; border-radius: 8px; background: rgba(249,115,22,0.12);
        display: flex; align-items: center; justify-content: center; font-size: 15px;
    }
    .cat-name { font-weight: 600; color: #fff; }
    .cat-desc { font-size: 11px; color: rgba(255,255,255,0.4); }

    .badge {
        display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px;
        border-radius: 20px; font-size: 11px; font-weight: 700;
    }
    .badge--ok { background: rgba(34, 197, 94, 0.12); color: #4ade80; }
    .badge--off { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.4); }

    .row-actions { display: flex; gap: 6px; }
    .row-actions button {
        width: 30px; height: 30px; border-radius: 8px; background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08); color: #fff; cursor: pointer; font-size: 13px;
    }
    .row-actions button:hover { background: rgba(249,115,22,0.15); border-color: rgba(249,115,22,0.4); }
    .row-actions button.danger:hover { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.4); }

    .state-box {
        padding: 40px 20px; text-align: center; color: rgba(255,255,255,0.45); font-size: 14px;
    }
    .state-box--error { color: #f87171; display: flex; flex-direction: column; gap: 12px; align-items: center; }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .kpi-card {
        background: #141a22;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 16px 18px;
    }

    .kpi-card__icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        margin-bottom: 10px;
    }

    .kpi-card--total .kpi-card__icon {
        background: rgba(249,115,22,0.12);
    }

    .kpi-card--active .kpi-card__icon {
        background: rgba(34, 197, 94, 0.12);
    }

    .kpi-card--inactive .kpi-card__icon {
        background: rgba(255,255,255,0.06);
    }

    .kpi-card--products .kpi-card__icon {
        background: rgba(59, 130, 246, 0.12);
    }

    .kpi-card__value {
        font-size: 22px;
        font-weight: 800;
        color: #fff;
        margin-bottom: 2px;
    }

    .kpi-card__label {
        font-size: 12px;
        color: rgba(255,255,255,0.5);
    }

    @@media (max-width: 900px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>