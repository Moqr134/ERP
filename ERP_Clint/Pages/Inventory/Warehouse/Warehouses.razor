@page "/inventory/warehouses"
@layout MainLayout
@attribute [Authorize(Roles = "FullAccess,GetAllWarehouses")]
@using ERP_Clint.Pages.Inventory.Category
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ERP_Clint.Security
@using ERP_Clint.Service
@using ERP_Clint.Service.InventoryService
@using ERPDto.WarehouseDto
@inject IWarehousesService WarehousesService

<div class="table-panel">
    <div class="table-panel__header">
        <h3>قائمة المخازن</h3>
        <div style="display:flex; gap:10px; align-items:center;">
            <div class="search-box">
                <span>🔍</span>
                <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="ابحث عن مخزن..." />
            </div>
            <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.AddWarehouse)">
                <Authorized>
                    <button class="btn-primary" @onclick="OpenAddModal">+ إضافة مخزن</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-box">جاري تحميل المخازن...</div>
    }
    else if (loadError is not null)
    {
        <div class="state-box state-box--error">
            ⚠ @loadError
            <button class="btn-secondary" @onclick="LoadWarehouses">إعادة المحاولة</button>
        </div>
    }
    else if (FilteredWarehouses.Count == 0)
    {
        <div class="state-box">لا توجد مخازن مطابقة</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>المخزن</th>
                    <th>الرمز</th>
                    <th>الموقع</th>
                    <th>الهاتف</th>
                    <th>المنتجات</th>
                    <th>الحالة</th>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.EditWarehouse, PermissionNames.DeleteWarehouse)">
                        <Authorized>
                            <th>إجراءات</th>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in FilteredWarehouses)
                {
                    <tr>
                        <td>
                            <div class="cat-cell">
                                <div class="cat-icon">🏬</div>
                                <div><div class="cat-name">@w.Name</div></div>
                            </div>
                        </td>
                        <td class="mono">@w.Code</td>
                        <td>@(string.IsNullOrWhiteSpace(w.Location) ? "—" : w.Location)</td>
                        <td>@(string.IsNullOrWhiteSpace(w.PhoneNumber) ? "—" : w.PhoneNumber)</td>
                        <td>@w.ProductCount</td>
                        <td>
                            @if (w.IsActive)
                            {
                                <span class="badge badge--ok">مفعّل</span>
                            }
                            else
                            {
                                <span class="badge badge--low">معطّل</span>
                            }
                        </td>
                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.EditWarehouse, PermissionNames.DeleteWarehouse)" Context="actionsCtx">
                            <Authorized>
                                <td>
                                    <div class="row-actions">
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.EditWarehouse)" Context="editCtx">
                                            <Authorized>
                                                <button @onclick="() => OpenEditModal(w)" title="تعديل">✏️</button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.DeleteWarehouse)" Context="delCtx">
                                            <Authorized>
                                                <button class="danger" @onclick="() => OpenDeleteModal(w)" title="حذف">🗑️</button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<WarehouseModal IsOpen="isModalOpen"
                EditingWarehouse="warehouseBeingEdited"
                OnSaved="HandleSaved"
                OnClose="CloseModal" />

<DeleteConfirmModal IsOpen="isDeleteModalOpen"
                     EntityLabel="المخزن"
                     TargetName="@(warehouseBeingDeleted?.Name ?? "")"
                     OnConfirm="HandleDeleteConfirmed"
                     OnCancel="CloseDeleteModal" />

@if (!string.IsNullOrEmpty(deleteError))
{
    <div class="toast-error">⚠ @deleteError</div>
}

<style>
    .table-panel { background: #141a22; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; overflow: hidden; }
    .table-panel__header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; gap: 12px; }
    .table-panel__header h3 { font-size: 15px; font-weight: 700; color: #fff; }
    .search-box { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 8px 12px; font-size: 13px; min-width: 220px; }
    .search-box input { background: none; border: none; outline: none; color: #fff; font-family: 'Cairo', sans-serif; font-size: 13px; width: 100%; }
    .search-box input::placeholder { color: rgba(255,255,255,0.3); }
    .btn-primary { background: linear-gradient(135deg, #f97316, #c2410c); border: none; color: #fff; font-weight: 700; padding: 9px 18px; border-radius: 10px; font-size: 13px; font-family: 'Cairo', sans-serif; cursor: pointer; }
    .btn-secondary { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #e8edf2; font-weight: 600; padding: 9px 18px; border-radius: 10px; font-size: 13px; font-family: 'Cairo', sans-serif; cursor: pointer; }
    table { width: 100%; border-collapse: collapse; }
    thead th { background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; padding: 12px 20px; text-align: right; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,0.08); }
    tbody td { padding: 14px 20px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.05); color: #e8edf2; }
    tbody tr:hover { background: rgba(249, 115, 22, 0.04); }
    .mono { font-family: ui-monospace, Consolas, monospace; direction: ltr; display: inline-block; color: rgba(255,255,255,0.75); }
    .cat-cell { display: flex; align-items: center; gap: 10px; }
    .cat-icon { width: 34px; height: 34px; border-radius: 8px; background: rgba(249,115,22,0.12); display: flex; align-items: center; justify-content: center; font-size: 15px; }
    .cat-name { font-weight: 600; color: #fff; }
    .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
    .badge--ok { background: rgba(34,197,94,0.12); color: #4ade80; }
    .badge--low { background: rgba(239,68,68,0.12); color: #f87171; }
    .row-actions { display: flex; gap: 6px; }
    .row-actions button { width: 30px; height: 30px; border-radius: 8px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #fff; cursor: pointer; font-size: 13px; }
    .row-actions button:hover { background: rgba(249,115,22,0.15); border-color: rgba(249,115,22,0.4); }
    .row-actions button.danger:hover { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.4); }
    .state-box { padding: 40px 20px; text-align: center; color: rgba(255,255,255,0.45); font-size: 14px; }
    .state-box--error { color: #f87171; display: flex; flex-direction: column; gap: 12px; align-items: center; }
    .toast-error { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.4); color: #f87171; padding: 12px 20px; border-radius: 10px; font-size: 13px; z-index: 200; }
</style>

@code {
    private List<WarehouseDto> warehouses = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string? loadError;

    private bool isModalOpen;
    private WarehouseDto? warehouseBeingEdited;

    private bool isDeleteModalOpen;
    private WarehouseDto? warehouseBeingDeleted;
    private string? deleteError;

    private List<WarehouseDto> FilteredWarehouses =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? warehouses
            : warehouses.Where(w =>
                (w.Name ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || (w.Code ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || (w.Location ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LoadWarehouses();

    private async Task LoadWarehouses()
    {
        isLoading = true;
        loadError = null;
        try
        {
            warehouses = await WarehousesService.GetAllWarehousesAsync();
        }
        catch
        {
            loadError = "تعذر تحميل المخازن، تأكد من اتصالك وحاول مرة أخرى";
            warehouses = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        warehouseBeingEdited = null;
        isModalOpen = true;
    }

    private void OpenEditModal(WarehouseDto warehouse)
    {
        warehouseBeingEdited = warehouse;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        warehouseBeingEdited = null;
    }

    private async Task HandleSaved()
    {
        isModalOpen = false;
        warehouseBeingEdited = null;
        await LoadWarehouses();
    }

    private void OpenDeleteModal(WarehouseDto warehouse)
    {
        warehouseBeingDeleted = warehouse;
        deleteError = null;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        warehouseBeingDeleted = null;
    }

    private async Task HandleDeleteConfirmed()
    {
        if (warehouseBeingDeleted is null) return;
        deleteError = null;
        try
        {
            var response = await WarehousesService.DeleteWarehouseAsync(warehouseBeingDeleted.Id);
            if (response.IsSuccessStatusCode)
            {
                isDeleteModalOpen = false;
                warehouseBeingDeleted = null;
                await LoadWarehouses();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotAcceptable)
            {
                isDeleteModalOpen = false;
                deleteError = "لا يمكن حذف المخزن لوجود منتجات مرتبطة به";
            }
            else
            {
                isDeleteModalOpen = false;
                deleteError = "تعذر حذف المخزن، حاول مرة أخرى";
            }
        }
        catch
        {
            isDeleteModalOpen = false;
            deleteError = "تعذر الاتصال بالخادم أثناء الحذف";
        }
    }
}
