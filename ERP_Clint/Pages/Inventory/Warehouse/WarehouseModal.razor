@using ERPDto.WarehouseDto
@using ERP_Clint.Service.InventoryService
@inject IWarehousesService WarehousesService

<div class="modal-overlay @(IsOpen ? "open" : "")">
    <div class="modal-box">
        <div class="modal-box__header">
            <h3>@(IsEditMode ? "تعديل المخزن" : "إضافة مخزن جديد")</h3>
            <button class="modal-close" @onclick="Close">✕</button>
        </div>

        <EditForm Model="@formModel" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">⚠ @errorMessage</div>
            }

            <div class="form-row-2">
                <div class="form-group">
                    <label>اسم المخزن</label>
                    <InputText @bind-Value="formModel.Name" class="form-input" placeholder="مثال: المخزن الرئيسي" />
                    <ValidationMessage For="@(() => formModel.Name)" />
                </div>
                <div class="form-group">
                    <label>رمز المخزن</label>
                    <InputText @bind-Value="formModel.Code" class="form-input" placeholder="مثال: WH-01" />
                    <ValidationMessage For="@(() => formModel.Code)" />
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label>الموقع</label>
                    <InputText @bind-Value="formModel.Location" class="form-input" placeholder="المدينة / العنوان" />
                    <ValidationMessage For="@(() => formModel.Location)" />
                </div>
                <div class="form-group">
                    <label>رقم الهاتف</label>
                    <InputText @bind-Value="formModel.PhoneNumber" class="form-input" placeholder="07XXXXXXXXX" />
                    <ValidationMessage For="@(() => formModel.PhoneNumber)" />
                </div>
            </div>

            <div class="form-group">
                <label>ملاحظات</label>
                <InputText @bind-Value="formModel.Notes" class="form-input" placeholder="اختياري" />
                <ValidationMessage For="@(() => formModel.Notes)" />
            </div>

            <div class="switch-row">
                <label>المخزن مفعّل</label>
                <label class="switch">
                    <InputCheckbox @bind-Value="formModel.IsActive" />
                    <span class="switch-track"></span>
                </label>
            </div>

            <div class="modal-box__footer">
                <button type="button" class="btn-secondary" @onclick="Close" disabled="@isSaving">إلغاء</button>
                <button type="submit" class="btn-primary" disabled="@isSaving">
                    @(isSaving ? "جاري الحفظ..." : "حفظ")
                </button>
            </div>
        </EditForm>
    </div>
</div>

<style>
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: none; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(3px); }
    .modal-overlay.open { display: flex; }
    .modal-box { width: 100%; max-width: 480px; background: #141a22; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 26px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); font-family: 'Cairo', sans-serif; color: #e8edf2; max-height: 90vh; overflow-y: auto; }
    .modal-box__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .modal-box__header h3 { font-size: 16px; font-weight: 700; color: #fff; }
    .modal-close { background: none; border: none; color: rgba(255,255,255,0.5); font-size: 18px; cursor: pointer; }
    .alert-error { background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 16px; }
    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 13px; margin-bottom: 8px; color: rgba(255,255,255,0.75); font-weight: 600; }
    .form-input { width: 100%; padding: 11px 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: #fff; font-size: 14px; font-family: 'Cairo', sans-serif; outline: none; box-sizing: border-box; }
    .form-input:focus { border-color: #f97316; background: rgba(255,255,255,0.06); }
    .validation-message { color: #f87171; font-size: 12px; margin-top: 6px; display: block; }
    .switch-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .switch-row > label { font-size: 13px; color: rgba(255,255,255,0.75); font-weight: 600; }
    .switch { position: relative; width: 42px; height: 24px; }
    .switch input { display: none; }
    .switch-track { position: absolute; inset: 0; background: rgba(255,255,255,0.1); border-radius: 20px; cursor: pointer; transition: .2s; }
    .switch-track::before { content: ""; position: absolute; width: 18px; height: 18px; border-radius: 50%; background: #fff; top: 3px; right: 3px; transition: .2s; }
    .switch input:checked + .switch-track { background: #f97316; }
    .switch input:checked + .switch-track::before { transform: translateX(-18px); }
    .modal-box__footer { display: flex; gap: 10px; margin-top: 8px; }
    .modal-box__footer button { flex: 1; }
    .btn-secondary { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #e8edf2; font-weight: 600; padding: 10px 18px; border-radius: 10px; font-size: 13px; font-family: 'Cairo', sans-serif; cursor: pointer; }
    .btn-primary { background: linear-gradient(135deg, #f97316, #c2410c); border: none; color: #fff; font-weight: 700; padding: 10px 18px; border-radius: 10px; font-size: 13px; font-family: 'Cairo', sans-serif; cursor: pointer; }
    button:disabled { opacity: 0.6; cursor: not-allowed; }

    @@media (max-width: 560px) {
        .form-row-2 { grid-template-columns: 1fr; }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public WarehouseDto? EditingWarehouse { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private WarehouseModel formModel = new();
    private bool isSaving;
    private string? errorMessage;

    private bool IsEditMode => EditingWarehouse is not null;

    protected override void OnParametersSet()
    {
        if (EditingWarehouse is not null)
        {
            formModel = new WarehouseModel
            {
                Id = EditingWarehouse.Id,
                Name = EditingWarehouse.Name,
                Code = EditingWarehouse.Code,
                Location = EditingWarehouse.Location,
                PhoneNumber = EditingWarehouse.PhoneNumber,
                IsActive = EditingWarehouse.IsActive,
                Notes = EditingWarehouse.Notes,
            };
        }
        else
        {
            formModel = new WarehouseModel { IsActive = true };
        }

        errorMessage = null;
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var response = IsEditMode
                ? await WarehousesService.UpdateWarehouseAsync(formModel)
                : await WarehousesService.CreateWarehouseAsync(formModel);

            if (response.IsSuccessStatusCode)
            {
                await OnSaved.InvokeAsync();
                await OnClose.InvokeAsync();
                return;
            }

            errorMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "رمز أو اسم المخزن مستخدم بالفعل"
                : "حدث خطأ أثناء الحفظ، حاول مرة أخرى";
        }
        catch
        {
            errorMessage = "تعذر الاتصال بالخادم";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        if (isSaving) return;
        await OnClose.InvokeAsync();
    }
}
