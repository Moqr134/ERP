<div class="modal-overlay @(IsOpen ? "open" : "")">
    <div class="modal-box">
        <div class="modal-box__header">
            <h3>@(IsEditMode ? "تعديل المنتج" : "إضافة منتج جديد")</h3>
            <button class="modal-close" @onclick="Close">✕</button>
        </div>
        @if (IsEditMode)
        {
            <EditForm Model="@formModel" OnValidSubmit="HandleSave">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-error">⚠ @errorMessage</div>
                }

                <div class="form-row-2">
                    <div class="form-group">
                        <label>كود المنتج</label>
                        <InputText @bind-Value="formModel.Barcode" class="form-input" placeholder="7943781001" />
                        <ValidationMessage For="@(() => formModel.Barcode)" />
                    </div>
                    <div class="form-group">
                        <label>اسم المنتج</label>
                        <InputText @bind-Value="formModel.Name" class="form-input" placeholder="اسم المنتج" />
                        <ValidationMessage For="@(() => formModel.Name)" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>القسم</label>
                        <InputSelect @bind-Value="formModel.CategoryId" class="form-input">
                            <option value="0">اختر القسم</option>
                            @foreach (var category in Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => formModel.CategoryId)" />

                    </div>

                    <div class="form-row-3">
                        <div class="form-group">
                            <label>السعر (د.ع)</label>
                            <InputNumber @bind-Value="formModel.Price" class="form-input" placeholder="0" />
                            <ValidationMessage For="@(() => formModel.Price)" />
                        </div>
                    </div>
                </div>
                <div class="modal-box__footer">
                    <button type="button" class="btn-secondary" @onclick="Close" disabled="@isSaving">إلغاء</button>
                    <button type="submit" class="btn-primary" disabled="@isSaving">
                        @(isSaving ? "جاري الحفظ..." : "حفظ")
                    </button>
                </div>
            </EditForm>
        }
        else{
            <EditForm Model="@Model" OnValidSubmit="HandleSave">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-error">⚠ @errorMessage</div>
                }
                <div class="form-group">
                    <label>اسم المنتج</label>
                    <InputText @bind-Value="Model.Name" class="form-input" placeholder="اسم المنتج" />
                    <ValidationMessage For="@(() => Model.Name)" />
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>كود المنتج</label>
                        <InputText @bind-Value="Model.SKU" class="form-input" placeholder="PRD-1001" />
                        <ValidationMessage For="@(() => Model.Barcode)" />
                    </div>
                    
                    <div class="form-group">
                        <label>رمز المنتج</label>
                        <InputText @bind-Value="Model.Barcode" class="form-input" placeholder="رمز المنتج" />
                        <ValidationMessage For="@(() => Model.SKU)" />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label>القسم</label>
                        <InputSelect @bind-Value="Model.CategoriesId" class="form-input">
                            <option value="0">اختر القسم</option>
                            @foreach (var category in Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.CategoriesId)" />

                    </div>

                    <div class="form-row-3">
                        <div class="form-group">
                            <label>سعر الكلفة (د.ع)</label>
                            <InputNumber @bind-Value="Model.CostPrice" class="form-input" placeholder="0" />
                            <ValidationMessage For="@(() => Model.CostPrice)" />
                        </div>
                    </div>
                    <div class="form-row-3">
                        <div class="form-group">
                            <label>السعر (د.ع)</label>
                            <InputNumber @bind-Value="Model.SellingPrice" class="form-input" placeholder="0" />
                            <ValidationMessage For="@(() => Model.SellingPrice)" />
                        </div>
                    </div>
                    <div class="form-row-3">
                        <div class="form-group">
                            <label> اقل كمية ممكنة</label>
                            <InputNumber @bind-Value="Model.MinStockLevel" class="form-input" placeholder="0" />
                            <ValidationMessage For="@(() => Model.MinStockLevel)" />
                        </div>
                    </div>
                </div>
                <div class="modal-box__footer">
                    <button type="button" class="btn-secondary" @onclick="Close" disabled="@isSaving">إلغاء</button>
                    <button type="submit" class="btn-primary" disabled="@isSaving">
                        @(isSaving ? "جاري الحفظ..." : "حفظ")
                    </button>
                </div>
            </EditForm>
        }
        
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.6);
        display: none; align-items: center; justify-content: center; z-index: 100;
        backdrop-filter: blur(3px);
    }
    .modal-overlay.open { display: flex; }

    .modal-box {
        width: 100%; max-width: 520px; background: #141a22;
        border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;
        padding: 26px; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        font-family: 'Cairo', sans-serif; color: #e8edf2;
        max-height: 90vh; overflow-y: auto;
    }
    .modal-box__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .modal-box__header h3 { font-size: 16px; font-weight: 700; color: #fff; }
    .modal-close { background: none; border: none; color: rgba(255,255,255,0.5); font-size: 18px; cursor: pointer; }

    .alert-error {
        background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35);
        color: #f87171; padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 16px;
    }

    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 13px; margin-bottom: 8px; color: rgba(255,255,255,0.75); font-weight: 600; }
    .form-input {
        width: 100%; padding: 11px 14px; background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: #fff;
        font-size: 14px; font-family: 'Cairo', sans-serif; outline: none;
        box-sizing: border-box;
    }
    .form-input:focus { border-color: #f97316; background: rgba(255,255,255,0.06); }
    select.form-input option { background: #141a22; color: #fff; }

    .field-hint {
        display: block; font-size: 11px; color: rgba(255,255,255,0.35); margin-top: 6px; line-height: 1.6;
    }
    .validation-message { color: #f87171; font-size: 12px; margin-top: 6px; display: block; }

    .switch-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .switch-row label { font-size: 13px; color: rgba(255,255,255,0.75); font-weight: 600; }
    .switch { position: relative; width: 42px; height: 24px; }
    .switch input { display: none; }
    .switch-track {
        position: absolute; inset: 0; background: rgba(255,255,255,0.1); border-radius: 20px; cursor: pointer; transition: .2s;
    }
    .switch-track::before {
        content: ""; position: absolute; width: 18px; height: 18px; border-radius: 50%;
        background: #fff; top: 3px; right: 3px; transition: .2s;
    }
    .switch input:checked + .switch-track { background: #f97316; }
    .switch input:checked + .switch-track::before { transform: translateX(-18px); }

    .modal-box__footer { display: flex; gap: 10px; margin-top: 8px; }
    .modal-box__footer button { flex: 1; }

    .btn-secondary {
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #e8edf2;
        font-weight: 600; padding: 10px 18px; border-radius: 10px; font-size: 13px;
        font-family: 'Cairo', sans-serif; cursor: pointer;
    }
    .btn-primary {
        background: linear-gradient(135deg, #f97316, #c2410c); border: none; color: #fff; font-weight: 700;
        padding: 10px 18px; border-radius: 10px; font-size: 13px; font-family: 'Cairo', sans-serif; cursor: pointer;
    }
    button:disabled { opacity: 0.6; cursor: not-allowed; }

    @@media (max-width: 560px) {
        .form-row-2, .form-row-3 { grid-template-columns: 1fr; }
    }
</style>
