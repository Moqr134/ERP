<div class="modal-overlay @(IsOpen ? "open" : "")">
    <div class="modal-box">
        <div class="modal-box__header">
            <h3>@(IsEditMode ? "تعديل حركة" : "إضافة حركة مخزون")</h3>
            <button class="modal-close" @onclick="Close">✕</button>
        </div>

        <EditForm Model="@formModel" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">⚠ @errorMessage</div>
            }

            <div class="form-group">
                <label>المخزن</label>
                <InputSelect @bind-Value="formModel.WarehouseId" class="form-input">
                    <option value="0">اختر المخزن</option>
                    @foreach (var w in warehouses)
                    {
                        <option value="@w.Id">@w.Name (@w.Code)</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>المنتج</label>
                <div class="search-select">
                    <input class="search-input form-input" placeholder="ابحث عن منتج بالاسم أو الكود..." @bind="productSearch" @bind:event="oninput" @onfocus="() => OpenDropdown()" />
                    <div class="search-list @(isDropdownOpen ? "open" : "")">
                        @if (FilteredProducts.Count == 0)
                        {
                            <div class="search-item disabled">لا توجد نتائج</div>
                        }
                        else
                        {
                            @foreach (var p in FilteredProducts)
                            {
                                <div class="search-item" @onclick="() => SelectProduct(p)">
                                    <div class="item-name">@p.Name</div>
                                    <div class="item-meta">@p.Barcode</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>الكمية</label>
                <InputNumber TValue="int" @bind-Value="formModel.Quantity" class="form-input" />
            </div>

            <div class="form-group">
                <label>النوع</label>
                <select @bind="formModel.TransactionType" class="form-input">
                    <option value="In">داخل</option>
                    <option value="Out">خارج</option>
                </select>
            </div>

            <div class="form-group">
                <label>ملاحظات (اختياري)</label>
                <InputTextArea @bind-Value="formModel.Notes" class="form-textarea" />
            </div>

            <div class="form-group">
                <label>مرجع (اختياري)</label>
                <InputText @bind-Value="formModel.ReferenceId" class="form-input" />
            </div>

            <div class="modal-box__footer">
                <button type="button" class="btn-secondary" @onclick="Close" disabled="@isSaving">إلغاء</button>
                <button type="submit" class="btn-primary" disabled="@isSaving">@(isSaving ? "جاري الحفظ..." : "تنفيذ الحركة")</button>
            </div>
        </EditForm>
    </div>
</div>

<style>
    /* reuse modal styles similar to other modals */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: none; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(3px); }
    .modal-overlay.open { display: flex; }
    .modal-box { width: 100%; max-width: 520px; background: #141a22; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 26px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); font-family: 'Cairo', sans-serif; color: #e8edf2; }
    .modal-box__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .modal-box__header h3 { font-size: 16px; font-weight: 700; color: #fff; }
    .modal-close { background: none; border: none; color: rgba(255,255,255,0.5); font-size: 18px; cursor: pointer; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 13px; margin-bottom: 8px; color: rgba(255,255,255,0.75); font-weight: 600; }
    .form-input, .form-textarea { width: 100%; padding: 10px 12px; background-color: #141a22; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: #fff; font-size: 14px; color-scheme: dark; }
    .form-textarea { min-height: 70px; background: rgba(255,255,255,0.04); }
    select.form-input option { background-color: #141a22; color: #e8edf2; }
    .alert-error { background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 12px; }
    .modal-box__footer { display: flex; gap: 10px; margin-top: 8px; }
    .btn-secondary { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #e8edf2; font-weight: 600; padding: 10px 18px; border-radius: 10px; }
    .btn-primary { background: linear-gradient(135deg, #f97316, #c2410c); border: none; color: #fff; font-weight: 700; padding: 10px 18px; border-radius: 10px; }
    button:disabled { opacity: 0.6; cursor: not-allowed; }

    /* searchable select styles */
    .search-select { position: relative; }
    .search-input { width: 100%; box-sizing: border-box; }
    .search-list { position: absolute; left: 0; right: 0; max-height: 240px; overflow: auto; background: #0f1418; border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; margin-top: 6px; display: none; z-index: 40; }
    .search-list.open { display: block; }
    .search-item { padding: 10px 12px; display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid rgba(255,255,255,0.03); cursor: pointer; }
    .search-item:hover { background: rgba(255,255,255,0.02); }
    .search-item.disabled { color: rgba(255,255,255,0.35); cursor: default; }
    .item-name { font-weight: 600; color: #fff; }
    .item-meta { font-size: 12px; color: rgba(255,255,255,0.45); }
</style>
