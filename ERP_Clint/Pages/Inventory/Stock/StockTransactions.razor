@page "/inventory/stock-movements"
@layout MainLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using ERPDto.StockTransactionDto
@using ERP_Clint.Service.InventoryService
@inject IStockTransactionsService StockTransactionsService

<div class="table-panel">
    <div class="table-panel__header">
        <h3>حركات المخزون</h3>
        <div class="header-actions">
            <div class="search-box">
                <span>🔍</span>
                <input placeholder="ابحث بالمنتج، النوع أو المرجع..." @bind="search" @bind:event="oninput" />
            </div>
            <div style="display:flex; gap:8px; align-items:center;">
                <button class="btn-secondary" @onclick="() => { search = string.Empty; }">مسح البحث</button>
                <button class="btn-primary" @onclick="Reload">تحديث</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-box">جاري تحميل الحركات...</div>
    }
    else if (transactions is null || transactions.Count == 0)
    {
        <div class="state-box">لا توجد حركات حالياً</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th style="width:140px">الوقت</th>
                    <th>المنتج</th>
                    <th style="width:120px">النوع</th>
                    <th style="width:90px">الكمية</th>
                    <th style="width:140px">المرجع</th>
                    <th>الملاحظات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in FilteredTransactions)
                {
                    <tr>
                        <td class="mono">@t.CreateDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@t.ProductName</td>
                        <td>@(t.TransactionType == "In" ? "داخل" : t.TransactionType == "Out" ? "خارج" : t.TransactionType)</td>
                        <td>@t.Quantity</td>
                        <td class="mono">@t.ReferenceId</td>
                        <td>@t.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<StockTransactionDto> transactions = new();
    private bool isLoading = true;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        isLoading = true;
        try
        {
            transactions = await StockTransactionsService.GetStockTransactionsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Reload() => await LoadTransactions();

    private IEnumerable<StockTransactionDto> FilteredTransactions =>
        string.IsNullOrWhiteSpace(search)
            ? transactions
            : transactions.Where(t => (t.ProductName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                                   || (t.TransactionType ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                                   || (t.ReferenceId ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase));
}

<style>
    .table-panel { background: #141a22; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; overflow: hidden; }
    .table-panel__header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; gap: 12px; }
    .table-panel__header h3 { font-size: 15px; font-weight: 700; color: #fff; }
    .header-actions { display:flex; gap:12px; align-items:center; }
    .search-box { display:flex; align-items:center; gap:8px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 8px 12px; font-size:13px; }
    .search-box input { background:none; border:none; outline:none; color:#fff; font-family:'Cairo',sans-serif; width:260px; }
    table { width:100%; border-collapse: collapse; }
    thead th { background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.6); font-size: 12px; text-transform: uppercase; padding: 12px 16px; text-align: right; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,0.08); }
    tbody td { padding: 12px 16px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.04); color: #e8edf2; }
    tbody tr:hover { background: rgba(249,115,22,0.03); }
    .mono { font-family: monospace; color: rgba(255,255,255,0.75); }
    .btn-secondary { background: rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#e8edf2; padding:8px 12px; border-radius:10px; }
    .btn-primary { background: linear-gradient(135deg,#f97316,#c2410c); border:none; color:#fff; padding:8px 12px; border-radius:10px; }
    .state-box { padding: 28px; text-align:center; color: rgba(255,255,255,0.45); }
</style>
