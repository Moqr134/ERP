@using ERPDto.UserDto
@using System.ComponentModel.DataAnnotations

<div class="modal-overlay @(IsOpen ? "open" : "")">
    <div class="modal-box">
        <div class="modal-box__header">
            <h3>تغيير كلمة مرور: @User?.Username</h3>
            <button class="modal-close" @onclick="Close">✕</button>
        </div>

        <EditForm Model="@formModel" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">⚠ @errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert-ok">✓ @successMessage</div>
            }

            <div class="form-group">
                <label>كلمة المرور الجديدة</label>
                <InputText @bind-Value="formModel.NewPassword" type="password" class="form-input" />
                <ValidationMessage For="@(() => formModel.NewPassword)" />
            </div>

            <div class="form-group">
                <label>تأكيد كلمة المرور</label>
                <InputText @bind-Value="formModel.ConfirmPassword" type="password" class="form-input" />
                <ValidationMessage For="@(() => formModel.ConfirmPassword)" />
            </div>

            <div class="modal-box__footer">
                <button type="button" class="btn-secondary" @onclick="Close" disabled="@isSaving">إلغاء</button>
                <button type="submit" class="btn-primary" disabled="@isSaving">
                    @(isSaving ? "جاري الحفظ..." : "تغيير")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public UserDetailDto? User { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Inject] private ERP_Clint.Service.UserAdmin.IUserAdminService UserService { get; set; } = default!;

    private PasswordForm formModel = new();
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    protected override void OnParametersSet()
    {
        formModel = new();
        errorMessage = null;
        successMessage = null;
    }

    private async Task HandleSave()
    {
        if (User is null) return;
        if (formModel.NewPassword != formModel.ConfirmPassword)
        {
            errorMessage = "كلمتا المرور غير متطابقتين";
            return;
        }

        isSaving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var response = await UserService.ChangePasswordAsync(new ChangePasswordDto
            {
                UserId = User.Id,
                NewPassword = formModel.NewPassword
            });
            if (response.IsSuccessStatusCode)
            {
                successMessage = "تم تغيير كلمة المرور";
                await OnSaved.InvokeAsync();
            }
            else
            {
                errorMessage = await ERP_Clint.Service.ApiErrorHelper.ReadMessageAsync(response, "فشل تغيير كلمة المرور");
            }
        }
        catch
        {
            errorMessage = "تعذر الاتصال بالخادم";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        if (isSaving) return;
        await OnClose.InvokeAsync();
    }

    private class PasswordForm
    {
        [Required(ErrorMessage = "كلمة المرور مطلوبة")]
        [StringLength(100, MinimumLength = 5, ErrorMessage = "5 أحرف على الأقل")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "التأكيد مطلوب")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

<style>
    .alert-ok { background:rgba(34,197,94,0.12); border:1px solid rgba(34,197,94,0.35); color:#4ade80; padding:10px 14px; border-radius:10px; margin-bottom:12px; font-size:13px; }
</style>
