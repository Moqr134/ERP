@page "/users"
@layout MainLayout
@attribute [Authorize(Roles = "FullAccess,GetUsers")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ERPDto.UserDto
@using ERP_Clint.Security

@if (!isLoading && loadError is null && usersInfo is not null)
{
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-card__icon">👥</div>
            <div class="kpi-card__value">@usersInfo.TotalUsers</div>
            <div class="kpi-card__label">إجمالي المستخدمين</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card__icon">✅</div>
            <div class="kpi-card__value">@usersInfo.ActiveUsers</div>
            <div class="kpi-card__label">نشطون</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card__icon">⛔</div>
            <div class="kpi-card__value">@usersInfo.InactiveUsers</div>
            <div class="kpi-card__label">معطّلون</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-card__icon">🟢</div>
            <div class="kpi-card__value">@usersInfo.OnlineUsers</div>
            <div class="kpi-card__label">متصلون الآن</div>
        </div>
    </div>
}

<div class="table-panel">
    <div class="table-panel__header">
        <h3>إدارة المستخدمين</h3>
        <div class="header-actions">
            <div class="search-box">
                <span>🔍</span>
                <input type="text" value="@searchTerm" @oninput="OnSearchChanged" placeholder="ابحث بالاسم أو البريد..." />
            </div>
            <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllRoles)">
                <Authorized>
                    <a class="btn-secondary" href="users/roles">الأدوار</a>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.CreateUser)">
                <Authorized>
                    <button class="btn-primary" @onclick="OpenAddModal">+ إضافة مستخدم</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-box">جاري تحميل المستخدمين...</div>
    }
    else if (loadError is not null)
    {
        <div class="state-box state-box--error">
            ⚠ @loadError
            <button class="btn-secondary" @onclick="LoadAll">إعادة المحاولة</button>
        </div>
    }
    else if (users.Count == 0)
    {
        <div class="state-box">لا يوجد مستخدمون مطابقون</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>المستخدم</th>
                    <th>الدور</th>
                    <th>الحالة</th>
                    <th>آخر دخول</th>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.UpdateUser, PermissionNames.DeleteUser, PermissionNames.UpdateUserPermission, PermissionNames.ChangePassword, PermissionNames.SetUserActive)">
                        <Authorized>
                            <th>إجراءات</th>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">@GetInitial(user.Username)</div>
                                <div>
                                    <div class="user-name">@user.Username</div>
                                    <div class="user-email">@user.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>@(user.RoleNames.Count == 0 ? "—" : string.Join("، ", user.RoleNames))</td>
                        <td>
                            <span class="badge @(user.IsActive ? "badge--ok" : "badge--off")">
                                @(user.IsActive ? "نشط" : "معطّل")
                            </span>
                            @if (user.IsOnline)
                            {
                                <span class="badge badge--online">متصل</span>
                            }
                        </td>
                        <td>@(user.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.UpdateUser, PermissionNames.DeleteUser, PermissionNames.UpdateUserPermission, PermissionNames.ChangePassword, PermissionNames.SetUserActive)" Context="actionsCtx">
                            <Authorized>
                                <td>
                                    <div class="row-actions">
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.UpdateUser)" Context="editCtx">
                                            <Authorized>
                                                <button @onclick="() => OpenEditModal(user)" title="تعديل">✏️</button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetUserPermissions, PermissionNames.UpdateUserPermission)" Context="permCtx">
                                            <Authorized>
                                                <button @onclick="() => OpenPermissionsModal(user)" title="الصلاحيات">🔐</button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.ChangePassword)" Context="passCtx">
                                            <Authorized>
                                                <button @onclick="() => OpenPasswordModal(user)" title="كلمة المرور">🔑</button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.SetUserActive)" Context="activeCtx">
                                            <Authorized>
                                                <button @onclick="() => ToggleActive(user)" title="@(user.IsActive ? "تعطيل" : "تفعيل")">
                                                    @(user.IsActive ? "🚫" : "✅")
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.DeleteUser)" Context="delCtx">
                                            <Authorized>
                                                <button class="danger" @onclick="() => OpenDeleteModal(user)" title="حذف">🗑️</button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pager">
            <span class="pager__info">
                صفحة @(page.PageIndex) من @CurrentTotalPages — إجمالي @(listResponse?.TotalCount ?? 0)
            </span>
            <div class="pager__controls">
                <button class="pager__btn" disabled="@(page.PageIndex <= 1)" @onclick="() => GoToPage(page.PageIndex - 1)">‹ السابق</button>
                <button class="pager__btn" disabled="@(page.PageIndex >= CurrentTotalPages || CurrentTotalPages == 0)" @onclick="() => GoToPage(page.PageIndex + 1)">التالي ›</button>
            </div>
        </div>
    }
</div>

<UserModal IsOpen="isModalOpen"
           EditingUser="userBeingEdited"
           Roles="roles"
           OnSaved="HandleSaved"
           OnClose="CloseModal" />

<UserPermissionsModal IsOpen="isPermissionsOpen"
                      User="permissionsUser"
                      OnClose="ClosePermissionsModal"
                      OnSaved="HandlePermissionsSaved" />

<ChangePasswordModal IsOpen="isPasswordOpen"
                     User="passwordUser"
                     OnClose="ClosePasswordModal"
                     OnSaved="HandlePasswordSaved" />

@if (isDeleteModalOpen)
{
    <div class="modal-overlay open">
        <div class="modal-box modal-box--sm">
            <p class="confirm-text">هل أنت متأكد من حذف المستخدم <strong>@userBeingDeleted?.Username</strong>؟</p>
            @if (!string.IsNullOrEmpty(actionError))
            {
                <div class="alert-error">⚠ @actionError</div>
            }
            <div class="modal-box__footer">
                <button class="btn-secondary" @onclick="CloseDeleteModal">إلغاء</button>
                <button class="btn-danger" @onclick="HandleDeleteConfirmed">حذف</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(actionError) && !isDeleteModalOpen)
{
    <div class="toast-error">⚠ @actionError</div>
}

<style>
    .kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; margin-bottom:20px; }
    .kpi-card { background:#141a22; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:16px 18px; }
    .kpi-card__icon { font-size:20px; margin-bottom:6px; }
    .kpi-card__value { font-size:26px; font-weight:800; color:#fff; }
    .kpi-card__label { font-size:13px; color:rgba(255,255,255,0.5); font-weight:600; }
    .table-panel { background:#141a22; border:1px solid rgba(255,255,255,0.08); border-radius:14px; overflow:hidden; }
    .table-panel__header { display:flex; align-items:center; justify-content:space-between; padding:18px 20px; border-bottom:1px solid rgba(255,255,255,0.08); flex-wrap:wrap; gap:12px; }
    .table-panel__header h3 { font-size:15px; font-weight:700; color:#fff; margin:0; }
    .header-actions { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    .search-box { display:flex; align-items:center; gap:8px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; padding:8px 12px; }
    .search-box input { background:none; border:none; outline:none; color:#fff; font-family:'Cairo',sans-serif; width:220px; }
    table { width:100%; border-collapse:collapse; }
    thead th { background:rgba(255,255,255,0.03); color:rgba(255,255,255,0.6); font-size:12px; padding:12px 16px; text-align:right; font-weight:700; border-bottom:1px solid rgba(255,255,255,0.08); }
    tbody td { padding:12px 16px; font-size:13px; border-bottom:1px solid rgba(255,255,255,0.04); color:#e8edf2; }
    tbody tr:hover { background:rgba(249,115,22,0.03); }
    .user-cell { display:flex; align-items:center; gap:12px; }
    .user-avatar { width:36px; height:36px; border-radius:10px; background:linear-gradient(135deg,#f97316,#c2410c); display:flex; align-items:center; justify-content:center; font-weight:800; color:#fff; }
    .user-name { font-weight:700; color:#fff; }
    .user-email { font-size:12px; color:rgba(255,255,255,0.45); }
    .badge { display:inline-block; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:700; margin-left:4px; }
    .badge--ok { background:rgba(34,197,94,0.15); color:#4ade80; }
    .badge--off { background:rgba(239,68,68,0.15); color:#f87171; }
    .badge--online { background:rgba(59,130,246,0.15); color:#60a5fa; }
    .row-actions { display:flex; gap:6px; }
    .row-actions button { background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:8px; cursor:pointer; padding:6px 8px; }
    .row-actions button.danger { border-color:rgba(239,68,68,0.35); }
    .btn-primary { background:linear-gradient(135deg,#f97316,#c2410c); border:none; color:#fff; padding:9px 14px; border-radius:10px; font-family:'Cairo',sans-serif; font-weight:700; cursor:pointer; text-decoration:none; }
    .btn-secondary { background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#e8edf2; padding:9px 14px; border-radius:10px; font-family:'Cairo',sans-serif; cursor:pointer; text-decoration:none; }
    .btn-danger { background:#dc2626; border:none; color:#fff; padding:9px 14px; border-radius:10px; cursor:pointer; }
    .state-box { padding:28px; text-align:center; color:rgba(255,255,255,0.45); }
    .state-box--error { color:#f87171; display:flex; flex-direction:column; gap:12px; align-items:center; }
    .pager { display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-top:1px solid rgba(255,255,255,0.08); }
    .pager__info { font-size:12px; color:rgba(255,255,255,0.5); }
    .pager__controls { display:flex; gap:8px; }
    .pager__btn { background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:#fff; border-radius:8px; padding:6px 10px; cursor:pointer; }
    .pager__btn:disabled { opacity:.4; cursor:not-allowed; }
    .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.6); display:none; align-items:center; justify-content:center; z-index:100; }
    .modal-overlay.open { display:flex; }
    .modal-box { width:100%; max-width:420px; background:#141a22; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:24px; color:#e8edf2; }
    .modal-box--sm { max-width:360px; }
    .confirm-text { text-align:center; line-height:1.7; }
    .modal-box__footer { display:flex; gap:10px; margin-top:16px; }
    .modal-box__footer button { flex:1; }
    .alert-error { background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.35); color:#f87171; padding:10px 14px; border-radius:10px; margin-bottom:12px; font-size:13px; }
    .toast-error { position:fixed; bottom:20px; left:20px; background:rgba(239,68,68,0.95); color:#fff; padding:12px 16px; border-radius:10px; z-index:200; }
</style>
