@using ERPDto.RolesDto
@using System.ComponentModel.DataAnnotations

<div class="modal-overlay @(IsOpen ? "open" : "")">
    <div class="modal-box">
        <div class="modal-box__header">
            <h3>@(IsEditMode ? "تعديل دور" : "إضافة دور جديد")</h3>
            <button class="modal-close" @onclick="Close">✕</button>
        </div>

        <EditForm Model="@formModel" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">⚠ @errorMessage</div>
            }

            <div class="form-group">
                <label>اسم الدور</label>
                <InputText @bind-Value="formModel.Name" class="form-input" />
                <ValidationMessage For="@(() => formModel.Name)" />
            </div>

            <div class="form-group">
                <label>الوصف</label>
                <InputTextArea @bind-Value="formModel.Description" class="form-input" />
            </div>

            <div class="modal-box__footer">
                <button type="button" class="btn-secondary" @onclick="Close" disabled="@isSaving">إلغاء</button>
                <button type="submit" class="btn-primary" disabled="@isSaving">
                    @(isSaving ? "جاري الحفظ..." : "حفظ")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public RoleDto? EditingRole { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Inject] private ERP_Clint.Service.UserAdmin.IRoleAdminService RoleService { get; set; } = default!;

    private RoleForm formModel = new();
    private bool isSaving;
    private string? errorMessage;
    private bool IsEditMode => EditingRole is not null;

    protected override void OnParametersSet()
    {
        formModel = EditingRole is null
            ? new RoleForm()
            : new RoleForm { Name = EditingRole.Name, Description = EditingRole.Description };
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            HttpResponseMessage response;
            if (IsEditMode && EditingRole is not null)
            {
                response = await RoleService.UpdateRoleAsync(new RoleDto
                {
                    Id = EditingRole.Id,
                    Name = formModel.Name,
                    Description = formModel.Description
                });
            }
            else
            {
                response = await RoleService.CreateRoleAsync(new RoleDto
                {
                    Name = formModel.Name,
                    Description = formModel.Description
                });
            }

            if (response.IsSuccessStatusCode)
                await OnSaved.InvokeAsync();
            else
                errorMessage = await ERP_Clint.Service.ApiErrorHelper.ReadMessageAsync(response, "فشل حفظ الدور");
        }
        catch
        {
            errorMessage = "تعذر الاتصال بالخادم";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        if (isSaving) return;
        await OnClose.InvokeAsync();
    }

    private class RoleForm
    {
        [Required(ErrorMessage = "اسم الدور مطلوب")]
        [StringLength(100, MinimumLength = 2)]
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}

<style>
    .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.6); display:none; align-items:center; justify-content:center; z-index:110; }
    .modal-overlay.open { display:flex; }
    .modal-box { width:100%; max-width:420px; background:#141a22; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:24px; color:#e8edf2; font-family:'Cairo',sans-serif; }
    .modal-box__header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
    .modal-box__header h3 { margin:0; font-size:16px; color:#fff; }
    .modal-close { background:none; border:none; color:rgba(255,255,255,0.5); font-size:18px; cursor:pointer; }
    .form-group { margin-bottom:14px; }
    .form-group label { display:block; margin-bottom:6px; font-size:13px; color:rgba(255,255,255,0.75); font-weight:600; }
    .form-input { width:100%; padding:11px 14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff; font-family:'Cairo',sans-serif; box-sizing:border-box; }
    .alert-error { background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.35); color:#f87171; padding:10px 14px; border-radius:10px; margin-bottom:12px; font-size:13px; }
    .modal-box__footer { display:flex; gap:10px; }
    .modal-box__footer button { flex:1; }
    .btn-secondary { background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#e8edf2; padding:10px; border-radius:10px; cursor:pointer; }
    .btn-primary { background:linear-gradient(135deg,#f97316,#c2410c); border:none; color:#fff; padding:10px; border-radius:10px; font-weight:700; cursor:pointer; }
</style>
