@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ERP_Clint.Service.InventoryService
@using ERP_Clint.Service.ReportsService
@using ERPDto.ProductsDto
@using ERPDto.ReportsDto
@using ERP_Clint.Pages.Inventory.Stock
@using ERP_Clint.Security
@page "/"
@layout MainLayout
@attribute [Authorize]
@inject IProductService ProductService
@inject ICatigoryService CategoryService
@inject IReportsService ReportsService

<PageTitle>الرئيسية</PageTitle>

<div class="home-page">
    <div class="page-hero">
        <div class="page-hero__glow"></div>
        <div class="page-hero__content">
            <p class="page-hero__eyebrow">لوحة التحكم</p>
            <h1>مرحباً بك في نظام ERP</h1>
            <p>نظرة سريعة على المخزون، المبيعات، والاختصارات اليومية</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-box">جاري تحميل البيانات...</div>
    }
    else
    {
        <div class="kpi-grid kpi-grid--animate">
            <div class="kpi-card kpi-card--lift kpi-card--total">
                <div class="kpi-card__icon">🏷️</div>
                <div class="kpi-card__value">@(overview?.TotalProducts ?? productsInfo?.TotalProducts ?? 0)</div>
                <div class="kpi-card__label">إجمالي المنتجات</div>
            </div>
            <div class="kpi-card kpi-card--lift kpi-card--low">
                <div class="kpi-card__icon">⚠️</div>
                <div class="kpi-card__value">@(overview?.LowStockProducts ?? productsInfo?.ProductsCountLissMinStock ?? 0)</div>
                <div class="kpi-card__label">وصلت للحد الأدنى</div>
            </div>
            <div class="kpi-card kpi-card--lift kpi-card--out">
                <div class="kpi-card__icon">⛔</div>
                <div class="kpi-card__value">@(overview?.OutOfStockProducts ?? productsInfo?.ProductsStockOut ?? 0)</div>
                <div class="kpi-card__label">نافذة من المخزون</div>
            </div>
            <div class="kpi-card kpi-card--lift kpi-card--value">
                <div class="kpi-card__icon">📦</div>
                <div class="kpi-card__value">@(overview?.TotalCategories ?? categoriesCount)</div>
                <div class="kpi-card__label">عدد الأصناف</div>
            </div>
        </div>

        @if (overview is not null)
        {
            <div class="kpi-grid" style="margin-top:14px">
                <div class="kpi-card kpi-card--lift kpi-card--sales">
                    <div class="kpi-card__icon">💰</div>
                    <div class="kpi-card__value">@overview.RevenueToday.ToString("N0")</div>
                    <div class="kpi-card__label">إيراد اليوم (@overview.SalesToday فاتورة)</div>
                </div>
                <div class="kpi-card kpi-card--lift">
                    <div class="kpi-card__icon">🧾</div>
                    <div class="kpi-card__value">@overview.SalesRevenue.ToString("N0")</div>
                    <div class="kpi-card__label">إجمالي المبيعات</div>
                </div>
                <div class="kpi-card kpi-card--lift">
                    <div class="kpi-card__icon">👥</div>
                    <div class="kpi-card__value">@overview.OnlineUsers</div>
                    <div class="kpi-card__label">متصلون الآن</div>
                </div>
                <div class="kpi-card kpi-card--lift">
                    <div class="kpi-card__icon">💵</div>
                    <div class="kpi-card__value">@overview.InventoryCostValue.ToString("N0")</div>
                    <div class="kpi-card__label">قيمة المخزون</div>
                </div>
            </div>

            <div class="report-grid" style="margin-top:18px">
                <section class="report-panel">
                    <div class="report-panel__header"><h3>المبيعات آخر 7 أيام</h3></div>
                    <ERP_Clint.Pages.Reports.TrendChart Items="overview.SalesLast7Days" />
                </section>
                <section class="report-panel">
                    <div class="report-panel__header"><h3>أفضل المنتجات مبيعاً</h3></div>
                    <ERP_Clint.Pages.Reports.BarChart Items="overview.TopSellingProducts" UseCount="true" />
                </section>
            </div>
        }

        <div class="quick-links">
            <h3>اختصارات سريعة</h3>
            <div class="quick-links__grid">
                <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllProductsAsync)">
                    <Authorized>
                        <a class="quick-link" href="inventory/products">
                            <span>🏷️</span>
                            <span>إدارة المنتجات</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllCategories)">
                    <Authorized>
                        <a class="quick-link" href="inventory/categories">
                            <span>🗂️</span>
                            <span>إدارة الأصناف</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.AddStockTransaction)">
                    <Authorized>
                        <button class="quick-link" @onclick="OpenStockModal" style="cursor:pointer;">
                            <span>🔄</span>
                            <span>حركة مخزون سريعة</span>
                        </button>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.CompleteSale)">
                    <Authorized>
                        <a class="quick-link" href="sales/pos">
                            <span>🛒</span>
                            <span>نقطة البيع</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetReportsOverview, PermissionNames.GetSalesReport)">
                    <Authorized>
                        <a class="quick-link" href="reports">
                            <span>📊</span>
                            <span>التقارير الشاملة</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    }
</div>

<StockTransactionModal IsOpen="isStockModalOpen" OnClose="CloseStockModal" OnSuccess="HandleStockSuccess" />
@code {
    private ProductsInfo? productsInfo;
    private DashboardOverviewReport? overview;
    private int categoriesCount;
    private bool isLoading = true;
    private bool isStockModalOpen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var infoTask = ProductService.GetProductsInfo(new ERPDto.PaigingDto.PageDto());
            var categoriesTask = CategoryService.GetAllCategoriesAsync();
            var overviewTask = TryLoadOverview();
            await Task.WhenAll(infoTask, categoriesTask, overviewTask);
            productsInfo = await infoTask;
            categoriesCount = (await categoriesTask).Count;
            overview = await overviewTask;
        }
        catch
        {
            productsInfo = null;
            categoriesCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<DashboardOverviewReport?> TryLoadOverview()
    {
        try
        {
            return await ReportsService.GetOverviewAsync(new ReportFilterDto { Top = 5 });
        }
        catch
        {
            return null;
        }
    }

    private void OpenStockModal()
    {
        isStockModalOpen = true;
    }

    private async Task CloseStockModal()
    {
        isStockModalOpen = false;
        await Task.CompletedTask;
    }

    private async Task HandleStockSuccess()
    {
        isLoading = true;
        try
        {
            productsInfo = await ProductService.GetProductsInfo(new ERPDto.PaigingDto.PageDto());
            overview = await TryLoadOverview();
        }
        catch
        {
            productsInfo = null;
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    .home-page {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .quick-links {
        margin-top: 22px;
    }

    .quick-links h3 {
        margin: 0 0 14px;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
    }

    .quick-links__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
    }

    .quick-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 18px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: background .15s, border-color .15s, color .15s, transform .15s;
        animation: fade-up 0.4s ease both;
    }

    .quick-link:hover {
        background: rgba(249,115,22,0.1);
        border-color: rgba(249,115,22,0.35);
        color: #fff;
        transform: translateY(-2px);
        text-decoration: none;
    }
</style>
