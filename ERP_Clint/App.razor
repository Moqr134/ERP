@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(LoginLayout)">
                <NotAuthorized>
                    <div style="padding: 20px; text-align: center;">
                        <h3>تنبيه حماية</h3>
                        <p>عذراً، أنت غير مخول لعرض هذه الصفحة. يرجى تسجيل الدخول أولاً.</p>
                        <a href="/login" class="btn btn-primary">الانتقال لصفحة تسجيل الدخول</a>
                    </div>
                </NotAuthorized>
                <Authorizing>
                    <p style="text-align: center; padding: 20px;">جاري التحقق من الهوية والتعرف على الصلاحيات...</p>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(LoginLayout)">
                <p style="text-align: center; padding: 20px;">عذراً، هذه الصفحة غير موجودة.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
