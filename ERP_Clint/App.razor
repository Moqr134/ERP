@using Microsoft.AspNetCore.Components.Authorization
@using ERP_Clint.Pages.AccountPages
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(LoginLayout)">
                <NotAuthorized>
                    @if (context.User?.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin ReturnUrl="@Navigation.ToBaseRelativePath(Navigation.Uri)" />
                    }
                    else
                    {
                        <div style="padding: 20px; text-align: center;">
                            <h3>تنبيه حماية</h3>
                            <p>عذراً، أنت غير مخول لعرض هذه الصفحة.</p>
                            <a href="/" class="btn btn-primary">العودة للرئيسية</a>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <p style="text-align: center; padding: 20px;">جاري التحقق من الهوية والتعرف على الصلاحيات...</p>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(LoginLayout)">
                <p style="text-align: center; padding: 20px;">عذراً، هذه الصفحة غير موجودة.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
