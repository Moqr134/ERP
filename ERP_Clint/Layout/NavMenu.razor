<style>
    .nav-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .nav-menu__section {
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 16px 12px 6px;
    }

    .nav-menu__link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 10px;
        color: rgba(255,255,255,0.65);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background .15s, color .15s;
    }

        .nav-menu__link:hover {
            background: rgba(255,255,255,0.05);
            color: #fff;
        }

    .nav-icon {
        font-size: 15px;
        width: 20px;
        text-align: center;
    }

    /* حالة الرابط النشط - Blazor يضيف هذا الكلاس تلقائياً */
    .nav-menu__link.active {
        background: linear-gradient(135deg, rgba(249,115,22,0.18), rgba(194,65,12,0.12));
        color: #fff;
        border: 1px solid rgba(249,115,22,0.35);
        box-shadow: inset 0 0 0 1px rgba(249,115,22,0.08);
    }

    /* ===== زر القائمة القابلة للطي (Toggle) ===== */
    .nav-menu__toggle {
        width: 100%;
        background: none;
        border: none;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        text-align: right;
    }

    .nav-arrow {
        margin-right: auto;
        font-size: 13px;
        color: rgba(255,255,255,0.35);
        transition: transform 0.2s ease;
    }

    .nav-menu__toggle.open .nav-arrow {
        transform: rotate(-90deg);
    }

    .nav-menu__toggle.open {
        color: #fff;
        background: rgba(255,255,255,0.04);
    }

    .nav-menu__link--soon {
        opacity: 0.45;
        cursor: default;
        position: relative;
    }

    .soon-badge {
        margin-right: auto;
        font-size: 10px;
        padding: 2px 7px;
        border-radius: 20px;
        background: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.45);
        font-weight: 700;
    }

    /* ===== القائمة الفرعية ===== */
    .nav-submenu {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.25s ease;
    }

        .nav-submenu.open {
            max-height: 260px; /* يكفي لأربع عناصر، زدها لو أضفت المزيد */
        }

    .nav-submenu__link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 12px 9px 12px;
        margin: 3px 0 3px 0;
        margin-right: 14px;
        border-right: 2px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: background .15s, color .15s, border-color .15s;
    }

        .nav-submenu__link:hover {
            background: rgba(255,255,255,0.04);
            color: #fff;
        }

        .nav-submenu__link.active {
            color: #f97316;
            border-right: 2px solid #f97316;
            background: rgba(249,115,22,0.08);
        }

        .nav-submenu__link .nav-icon {
            font-size: 13px;
        }
</style>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool isInventoryOpen;

    protected override void OnInitialized()
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        if (currentPath.Contains("/inventory/", StringComparison.OrdinalIgnoreCase))
        {
            isInventoryOpen = true;
        }
    }

    private void ToggleInventory()
    {
        isInventoryOpen = !isInventoryOpen;
    }
}
