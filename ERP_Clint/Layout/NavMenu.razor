@using Microsoft.AspNetCore.Components.Authorization
@using ERP_Clint.Security

<ul class="nav-menu">

    <li class="nav-menu__item">
        <NavLink class="nav-menu__link" href="" Match="NavLinkMatch.All">
            <span class="nav-icon">🏠</span>
            <span>الرئيسية</span>
        </NavLink>
    </li>

    <li class="nav-menu__section">العمليات</li>

    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetUsers, PermissionNames.GetAllRoles, PermissionNames.CreateUser, PermissionNames.CreateRole)">
        <Authorized>
            <li class="nav-menu__item">
                <button type="button" class="nav-menu__link nav-menu__toggle @(isUsersOpen ? "open" : "")" @onclick="ToggleUsers">
                    <span class="nav-icon">🤵</span>
                    <span>المستخدمون</span>
                    <span class="nav-arrow">›</span>
                </button>

                <ul class="nav-submenu @(isUsersOpen ? "open" : "")">
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetUsers)" Context="usersCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="users">
                                    <span class="nav-icon">👤</span>
                                    <span>قائمة المستخدمين</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllRoles)" Context="rolesCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="users/roles">
                                    <span class="nav-icon">🛡️</span>
                                    <span>الأدوار والصلاحيات</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </li>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.CompleteSale, PermissionNames.GetSales)">
        <Authorized>
            <li class="nav-menu__item">
                <button type="button" class="nav-menu__link nav-menu__toggle @(isSalesOpen ? "open" : "")" @onclick="ToggleSales">
                    <span class="nav-icon">💰</span>
                    <span>المبيعات</span>
                    <span class="nav-arrow">›</span>
                </button>

                <ul class="nav-submenu @(isSalesOpen ? "open" : "")">
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.CompleteSale)" Context="posCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="sales/pos">
                                    <span class="nav-icon">🛒</span>
                                    <span>نقطة البيع</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetSales)" Context="histCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="sales/history">
                                    <span class="nav-icon">🧾</span>
                                    <span>سجل المبيعات</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </li>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllCategories, PermissionNames.GetAllProductsAsync, PermissionNames.GetAllSuppliers, PermissionNames.GetAllWarehouses, PermissionNames.GetStockTransactions)">
        <Authorized>
            <li class="nav-menu__item">
                <button type="button" class="nav-menu__link nav-menu__toggle @(isInventoryOpen ? "open" : "")" @onclick="ToggleInventory">
                    <span class="nav-icon">📦</span>
                    <span>المخزون</span>
                    <span class="nav-arrow">›</span>
                </button>

                <ul class="nav-submenu @(isInventoryOpen ? "open" : "")">
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllCategories)" Context="catCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="inventory/categories">
                                    <span class="nav-icon">🗂️</span>
                                    <span>الأصناف</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllProductsAsync)" Context="prodCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="inventory/products">
                                    <span class="nav-icon">🏷️</span>
                                    <span>المنتجات</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllSuppliers)" Context="supCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="inventory/suppliers">
                                    <span class="nav-icon">🚚</span>
                                    <span>الموردون</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetAllWarehouses)" Context="whCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="inventory/warehouses">
                                    <span class="nav-icon">🏬</span>
                                    <span>المخازن</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetStockTransactions)" Context="stockCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="inventory/stock-movements">
                                    <span class="nav-icon">🔄</span>
                                    <span>حركات المخزون</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </li>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetReportsOverview, PermissionNames.GetProductsReport, PermissionNames.GetCategoriesReport, PermissionNames.GetUsersReport, PermissionNames.GetSalesReport, PermissionNames.GetStockReport)">
        <Authorized>
            <li class="nav-menu__item">
                <button type="button" class="nav-menu__link nav-menu__toggle @(isReportsOpen ? "open" : "")" @onclick="ToggleReports">
                    <span class="nav-icon">📊</span>
                    <span>التقارير</span>
                    <span class="nav-arrow">›</span>
                </button>

                <ul class="nav-submenu @(isReportsOpen ? "open" : "")">
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetReportsOverview)" Context="ovCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="reports">
                                    <span class="nav-icon">📈</span>
                                    <span>التقرير الشامل</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetSalesReport)" Context="srCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="reports/sales">
                                    <span class="nav-icon">💰</span>
                                    <span>تقرير المبيعات</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetProductsReport)" Context="prCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="reports/products">
                                    <span class="nav-icon">🏷️</span>
                                    <span>تقرير المنتجات</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetCategoriesReport)" Context="crCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="reports/categories">
                                    <span class="nav-icon">🗂️</span>
                                    <span>تقرير الأصناف</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetUsersReport)" Context="urCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="reports/users">
                                    <span class="nav-icon">👥</span>
                                    <span>تقرير المستخدمين</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="@PermissionHelper.Roles(PermissionNames.GetStockReport)" Context="strCtx">
                        <Authorized>
                            <li>
                                <NavLink class="nav-submenu__link" href="reports/stock">
                                    <span class="nav-icon">🔄</span>
                                    <span>تقرير المخزون</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </li>
        </Authorized>
    </AuthorizeView>

    <li class="nav-menu__item">
        <span class="nav-menu__link nav-menu__link--soon">
            <span class="nav-icon">🧾</span>
            <span>المحاسبة</span>
            <span class="soon-badge">قريباً</span>
        </span>
    </li>

    <li class="nav-menu__item">
        <span class="nav-menu__link nav-menu__link--soon">
            <span class="nav-icon">👥</span>
            <span>الموارد البشرية</span>
            <span class="soon-badge">قريباً</span>
        </span>
    </li>

</ul> 

<style>
    .nav-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .nav-menu__section {
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 16px 12px 6px;
    }

    .nav-menu__link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 10px;
        color: rgba(255,255,255,0.65);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background .15s, color .15s;
    }

        .nav-menu__link:hover {
            background: rgba(255,255,255,0.05);
            color: #fff;
        }

    .nav-icon {
        font-size: 15px;
        width: 20px;
        text-align: center;
    }

    .nav-menu__link.active {
        background: linear-gradient(135deg, rgba(249,115,22,0.18), rgba(194,65,12,0.12));
        color: #fff;
        border: 1px solid rgba(249,115,22,0.35);
        box-shadow: inset 0 0 0 1px rgba(249,115,22,0.08);
    }

    .nav-menu__toggle {
        width: 100%;
        background: none;
        border: none;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        text-align: right;
    }

    .nav-arrow {
        margin-right: auto;
        font-size: 13px;
        color: rgba(255,255,255,0.35);
        transition: transform 0.2s ease;
    }

    .nav-menu__toggle.open .nav-arrow {
        transform: rotate(-90deg);
    }

    .nav-menu__toggle.open {
        color: #fff;
        background: rgba(255,255,255,0.04);
    }

    .nav-menu__link--soon {
        opacity: 0.45;
        cursor: default;
        position: relative;
    }

    .soon-badge {
        margin-right: auto;
        font-size: 10px;
        padding: 2px 7px;
        border-radius: 20px;
        background: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.45);
        font-weight: 700;
    }

    .nav-submenu {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.25s ease;
    }

        .nav-submenu.open {
            max-height: 480px;
        }

    .nav-submenu__link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 12px 9px 12px;
        margin: 3px 0 3px 0;
        margin-right: 14px;
        border-right: 2px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: background .15s, color .15s, border-color .15s;
    }

        .nav-submenu__link:hover {
            background: rgba(255,255,255,0.04);
            color: #fff;
        }

        .nav-submenu__link.active {
            color: #f97316;
            border-right: 2px solid #f97316;
            background: rgba(249,115,22,0.08);
        }

        .nav-submenu__link .nav-icon {
            font-size: 13px;
        }
</style>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool isInventoryOpen;
    private bool isUsersOpen;
    private bool isSalesOpen;
    private bool isReportsOpen;

    protected override void OnInitialized()
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        if (currentPath.Contains("/inventory/", StringComparison.OrdinalIgnoreCase))
        {
            isInventoryOpen = true;
        }
        if (currentPath.Contains("/users", StringComparison.OrdinalIgnoreCase))
        {
            isUsersOpen = true;
        }
        if (currentPath.Contains("/sales", StringComparison.OrdinalIgnoreCase))
        {
            isSalesOpen = true;
        }
        if (currentPath.Contains("/reports", StringComparison.OrdinalIgnoreCase))
        {
            isReportsOpen = true;
        }
    }

    private void ToggleInventory()
    {
        isInventoryOpen = !isInventoryOpen;
    }

    private void ToggleUsers()
    {
        isUsersOpen = !isUsersOpen;
    }

    private void ToggleSales()
    {
        isSalesOpen = !isSalesOpen;
    }

    private void ToggleReports()
    {
        isReportsOpen = !isReportsOpen;
    }
}
