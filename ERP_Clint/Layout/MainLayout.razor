@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject PRMS_Clint.Services.IAccountService AccountService
@inject NavigationManager Navigation
@inject ERP_Clint.Service.CostumAuth CostumAuth

<div class="app-shell" dir="rtl">

    <aside class="app-sidebar">
        <div class="app-sidebar__brand">
            <div class="brand-logo">ERP</div>
            <span>نظام إدارة الموارد</span>
        </div>

        <nav class="app-sidebar__nav">
            <NavMenu />
        </nav>

        <div class="app-sidebar__footer">
            <span>الإصدار 1.0.0</span>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="app-topbar__title">
                <h2>لوحة التحكم</h2>
            </div>

            <div class="app-topbar__actions">
                <button class="icon-btn" title="الإشعارات">🔔</button>
                <AuthorizeView>
                    <Authorized>
                        <div class="user-menu">
                            <div class="user-chip">
                                <div class="user-avatar">@GetInitial(context.User.Identity?.Name)</div>
                                <span>@context.User.Identity?.Name</span>
                            </div>
                            <button class="logout-btn" @onclick="HandleLogout" title="تسجيل الخروج">⏻</button>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        return name.Trim()[0].ToString().ToUpper();
    }

    private async Task HandleLogout()
    {
        try
        {
            await AccountService.Logout();
        }
        catch
        {
            // continue local logout even if API call fails
        }

        CostumAuth.NotifyUserAuthenticationChanged();
        Navigation.NavigateTo("/login");
    }
}

