@inherits LayoutComponentBase

<div class="app-shell" dir="rtl">

    <aside class="app-sidebar">
        <div class="app-sidebar__brand">
            <div class="brand-logo">ERP</div>
            <span>نظام إدارة الموارد</span>
        </div>

        <nav class="app-sidebar__nav">
            <NavMenu />
        </nav>

        <div class="app-sidebar__footer">
            <span>الإصدار 1.0.0</span>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="app-topbar__title">
                <h2>لوحة التحكم</h2>
            </div>

            <div class="app-topbar__actions">
                <button class="icon-btn" title="الإشعارات">🔔</button>
                <div class="user-chip">
                    <div class="user-avatar">A</div>
                    <span>محمد</span>
                </div>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<style>
    .app-shell {
        display: flex;
        min-height: 100vh;
        background: var(--brand-bg, #0b0f14);
        color: var(--brand-text, #e8edf2);
        font-family: 'Cairo', sans-serif;
    }

    /* ===== Sidebar ===== */
    .app-sidebar {
        width: 260px;
        flex-shrink: 0;
        background: #10151c;
        border-left: 1px solid rgba(255,255,255,0.06);
        display: flex;
        flex-direction: column;
        padding: 20px 16px;
    }

    .app-sidebar__brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 6px 20px;
        margin-bottom: 16px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .app-sidebar__brand .brand-logo {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, #f97316, #c2410c);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 13px;
        color: #fff;
        flex-shrink: 0;
    }

    .app-sidebar__brand span {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    .app-sidebar__nav {
        flex: 1;
        overflow-y: auto;
    }

    .app-sidebar__footer {
        padding-top: 16px;
        border-top: 1px solid rgba(255,255,255,0.06);
        font-size: 12px;
        color: rgba(255,255,255,0.35);
        text-align: center;
    }

    /* ===== Main area ===== */
    .app-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .app-topbar {
        height: 68px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 28px;
        background: rgba(20, 26, 34, 0.6);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        backdrop-filter: blur(8px);
    }

    .app-topbar__title h2 {
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .app-topbar__actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .icon-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        width: 38px;
        height: 38px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 15px;
        color: #fff;
        transition: background .2s;
    }

    .icon-btn:hover {
        background: rgba(249, 115, 22, 0.15);
        border-color: rgba(249, 115, 22, 0.4);
    }

    .user-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 12px 6px 6px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 30px;
        cursor: pointer;
    }

    .user-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f97316, #c2410c);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
    }

    .user-chip span {
        font-size: 13px;
        font-weight: 600;
        color: #fff;
    }

    .app-content {
        flex: 1;
        padding: 28px;
        overflow-y: auto;
    }

    /* Scrollbar عام يتماشى مع الثيم */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }
    ::-webkit-scrollbar-track {
        background: transparent;
    }
    ::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.12);
        border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: rgba(249, 115, 22, 0.4);
    }
</style>
